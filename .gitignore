# Dependencies
node_modules/

# Environment — never commit real OTT Pay credentials
.env
.env.local
.env.*.local

# Database and runtime data.
#
# The leading slash is load-bearing: a bare `data/` matches a directory of that
# name at ANY depth, which silently excluded server/scripts/data from the
# repository. Nothing noticed until the application started reading that file at
# boot — at which point a fresh clone, which is exactly what Render builds,
# crashed with ENOENT and the deploy failed with no useful error.
/data/
*.db
*.db-wal
*.db-shm

# Downloaded source photography (large). The build outputs are committed under
# public/img/photos; see docs/PHOTOS.md for how to regenerate the sources.
# The contact sheets and raw downloads stay local; the small JSON indexes are
# committed so the selection tooling runs from a fresh clone.
/data/photos/raw/
/data/photos/openverse-raw/
/data/photos/targeted-raw/
/data/photos/preview/
/data/photos/sheets/

# Logs
*.log
npm-debug.log*

# Development artefacts
_shots/
_research/
_doc_*.txt
_doc_*.html
_ott_*.html
_raw_*.html
_txt_*.txt
*.tmp

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
