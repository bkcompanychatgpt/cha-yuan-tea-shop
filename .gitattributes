# Normalise line endings so a Windows checkout and a Linux container agree.
# Without this, Git's autocrlf would rewrite every .ejs and .mjs file on clone
# and produce a diff that touches the whole repository.
* text=auto eol=lf

# Explicitly binary: these must never be line-ending converted.
*.woff2 binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ico binary
*.db binary

# Generated, so they would only add noise to diffs.
package-lock.json -diff linguist-generated
public/img/photos/** linguist-generated
docs/photo-sheets/** linguist-documentation
