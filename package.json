{
  "name": "cha-yuan-tea-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Cha Yuan — a premium single-origin Chinese tea store with cart, checkout and OTT Pay local card 3DS payments.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "seed": "node server/seed.mjs",
    "reseed": "node server/seed.mjs --force",
    "demo": "node server/scripts/demo-order.mjs",
    "audit": "node server/scripts/db-audit.mjs",
    "test": "node server/scripts/smoke.mjs && node server/scripts/check-catalogue.mjs && node server/scripts/check-fulfilment.mjs && node server/scripts/check-skus.mjs && node server/scripts/check-badges.mjs && node server/scripts/contrast-check.mjs && node server/scripts/check-assets.mjs && node server/scripts/check-gaps.mjs && node server/scripts/lang-audit.mjs && node server/scripts/check-render.mjs",
    "smoke": "node server/scripts/smoke.mjs",
    "catalogue": "node server/scripts/check-catalogue.mjs",
    "catalogue:status": "node server/scripts/catalogue-status.mjs",
    "art": "node server/scripts/art-shapes.mjs",
    "art:preview": "node server/scripts/preview-artwork.mjs",
    "fulfilment": "node server/scripts/check-fulfilment.mjs",
    "skus": "node server/scripts/check-skus.mjs",
    "badges": "node server/scripts/check-badges.mjs",
    "badges:probe": "node server/scripts/probe-badges.mjs",
    "badges:sheet": "node server/scripts/sheet-badges.mjs",
    "badges:fetch": "node server/scripts/fetch-brand-marks.mjs",
    "orders:demo": "node server/scripts/demo-orders.mjs",
    "shot:el": "node server/scripts/shot-el.mjs",
    "assets": "node server/scripts/check-assets.mjs",
    "gaps": "node server/scripts/check-gaps.mjs",
    "coverage": "node server/scripts/coverage.mjs",
    "images": "node server/scripts/check-images.mjs",
    "probe": "node server/scripts/probe.mjs",
    "length": "node server/scripts/page-length.mjs",
    "compare": "node server/scripts/compare-deploy.mjs",
    "lang": "node server/scripts/lang-audit.mjs",
    "visual": "node server/scripts/visual-check.mjs",
    "contrast": "node server/scripts/contrast-check.mjs",
    "shots": "node server/scripts/screenshot.mjs",
    "fonts": "node server/scripts/fetch-fonts.mjs",
    "photos:survey": "node server/scripts/fetch-photos.mjs --contact",
    "photos:targeted": "node server/scripts/fetch-targeted.mjs",
    "photos:sheets": "node server/scripts/build-sheets.mjs",
    "photos:build": "node server/scripts/build-photos.mjs --preview",
    "photos:attach": "node server/scripts/attach-photos.mjs",
    "photos": "npm run photos:build && npm run photos:attach",
    "check:render": "node server/scripts/check-render.mjs"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
