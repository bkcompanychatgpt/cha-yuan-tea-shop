<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-col">
        <a class="brand" href="/" style="margin-bottom:18px">
          <img src="/img/logo.svg" alt="" style="height:46px" />
        </a>
        <p><%= store.tagline %></p>
        <p style="margin-top:14px">
          Buying in small lots direct from growers in Fujian, Yunnan, Anhui, Zhejiang and
          Guangdong. Every lot is tasted in a gaiwan before it is listed.
        </p>

        <div class="footer-contact">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a href="mailto:<%= company.email %>" class="link-underline"><%= company.email %></a>
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>Packed and shipped from China</span>
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span>Dispatched within 48 hours</span>
          </span>
        </div>

        <%
          /*
           * Contact channels.
           *
           * The row used to be four hard-coded icons all pointing at /about —
           * a dead link dressed as an account. It now shows email, which always
           * works, plus WhatsApp once a number has been supplied. Until then the
           * shop does not advertise a channel it cannot answer on; see
           * `config.whatsapp`.
           */
          const whatsapp = (config && config.whatsapp) ? config.whatsapp : null;
        %>
        <div class="footer-social">
          <% if (whatsapp) { %>
            <a href="<%= whatsapp.url %>" aria-label="Chat on WhatsApp" title="WhatsApp <%= whatsapp.display %>"
               target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5"/></svg>
            </a>
          <% } %>
          <a href="mailto:<%= company.email %>" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Tea by family</h4>
        <% (typeof categories !== 'undefined' ? categories : []).filter(c => c.kind === 'tea').slice(0, 8).forEach(c => { %>
          <a href="/shop?category=<%= encodeURIComponent(c.slug) %>"><%= c.name %> <span class="faint">(<%= c.product_count %>)</span></a>
        <% }) %>
      </div>

      <div class="footer-col">
        <h4>Shop</h4>
        <a href="/shop">All products</a>
        <a href="/shop?sort=newest">New arrivals</a>
        <% (typeof categories !== 'undefined' ? categories : []).filter(c => c.kind !== 'tea').forEach(c => { %>
          <a href="/shop?category=<%= encodeURIComponent(c.slug) %>"><%= c.name %></a>
        <% }) %>
        <a href="/shop?sort=price-asc">Under <%= money(3000) %></a>
      </div>

      <div class="footer-col">
        <h4>Help</h4>
        <a href="/guides">Brewing guides</a>
        <a href="/guides/how-to-brew-gongfu">How to brew gongfu</a>
        <a href="/guides/water-and-temperature">Water &amp; temperature</a>
        <a href="/order">Track an order</a>
        <a href="/contact">Contact us</a>
        <a href="/about">About us</a>
      </div>

      <div class="footer-col">
        <h4>Policies</h4>
        <a href="/shipping">Shipping policy</a>
        <a href="/refund">Refund &amp; returns</a>
        <a href="/terms">Terms of service</a>
        <a href="/privacy">Privacy policy</a>
        <a href="/credits">Photography &amp; illustrations</a>
      </div>

      <div class="footer-col">
        <h4>Secure payment</h4>
        <p style="font-size:0.82rem">
          Card payments are processed by our payment provider over a PCI-DSS compliant
          gateway with 3-D Secure 2 authentication. Card details never reach our servers.
        </p>

        <div class="footer-badges">
          <span>Harvest dated</span>
          <span>Small lots</span>
          <span>Dispatched in 48 hours</span>
        </div>
      </div>
    </div>

    <%#
      The network marks get their own full-width strip rather than a column.
      Seven plates in a 240px column wrapped to four ragged rows; across the
      footer they sit on one line, which is how every card scheme's brand
      guidelines show them and how the reference shops present them.
      Every mark here is a brand OTT Pay's local-card API actually settles —
      see docs/payment-methods.md. Nothing unsupported is shown.
    %>
    <div class="footer-pay-strip">
      <div class="wrap footer-pay-inner">
        <span class="footer-pay-label">Cards we accept</span>

        <div class="footer-pay">
          <%- include('pay-marks', { lazy: true }) %>
        </div>

        <span class="footer-pay-note">Credit and debit · 3-D Secure 2 · settled in <%= store.currency %></span>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© <%= year %> <%= store.name %>. All rights reserved.</span>
      <span class="mono tiny"><%= store.currency %> · all prices in <%= store.currency %></span>
      <span class="row" style="gap:18px">
        <a href="/terms" style="color:inherit">Terms</a>
        <a href="/privacy" style="color:inherit">Privacy</a>
        <a href="/shipping" style="color:inherit">Shipping</a>
        <a href="/refund" style="color:inherit">Refunds</a>
        <a href="/contact" style="color:inherit">Contact</a>
        <a href="/admin/login" style="color:inherit">Staff</a>
      </span>
    </div>
  </div>
</footer>
