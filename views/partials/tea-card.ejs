<article class="tea-card">
  <div class="tea-media">
    <a href="/tea/<%= product.slug %>" aria-label="<%= product.name %>">
      <img src="<%= product.hero_image %>" alt="<%= product.name %>" loading="lazy" />
      <% if (product.images && product.images[1]) { %>
        <img class="tea-media-alt" src="<%= product.images[1] %>" alt="" loading="lazy" aria-hidden="true" />
      <% } %>
    </a>

    <%# One badge, not three. A card carrying "Hand-strung", "Coin" and a
        "Visualisation" mark above a name, a paragraph, a spec line, a price, a
        star rating and a Details link reads as a marketplace listing; the same
        product with one badge, its name and its price reads as a shop. The
        disclosure mark stays because it is not decoration — it tells the customer
        the image is a rendering. %>
    <div class="tea-badges">
      <% if (product.is_new) { %><span class="badge badge-gold">New</span><% } %>
      <% (product.badges || []).slice(0, 1).forEach(b => { %><span class="badge"><%= b %></span><% }) %>
      <% if (!product.inStock) { %><span class="badge">Sold out</span><% } %>
    </div>

    <%# The customer must never mistake a rendered image for a photograph of the
        actual piece. The mark sits on the image itself, not in small print. %>
    <% if (product.is_illustrated) { %>
      <span class="illus-mark" title="Computer-rendered visualisation — studio photography pending">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 4l1.5 14.5L11 20l7-7z"/><path d="M2 4l5.5 5.5"/></svg>
        Visualisation
      </span>
    <% } %>

    <button class="tea-card-save" type="button" data-wishlist="<%= product.slug %>" aria-label="Save <%= product.name %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21l8.8-8.3a5 5 0 0 0 0-7.1Z"/></svg>
    </button>

    <% const dv = product.defaultVariant; %>
    <% if (dv && dv.stock > 0) { %>
      <div class="tea-quick">
        <button class="btn btn-sm btn-block"
                type="button"
                data-add-to-cart
                data-variant-id="<%= dv.id %>"
                data-quantity="1"
                data-slug="<%= product.slug %>"
                data-name="<%= product.name %>"
                data-variant-label="<%= dv.label %>"
                data-price-cents="<%= dv.price_cents %>"
                data-image="<%= product.hero_image %>"
                data-stock="<%= dv.stock %>">
          Add <%= dv.label %> — <%= money(dv.price_cents) %>
        </button>
      </div>
    <% } %>
  </div>

  <div class="tea-body">
    <div class="tea-origin">
      <%= product.tea_family %><% if (product.origin && product.origin !== '—') { %> · <%= product.origin.split(',').pop().trim() %><% } %>
    </div>
    <h3 class="tea-name"><a href="/tea/<%= product.slug %>"><%= product.name %></a></h3>

    <%#
      The two-line description is gone from the card.

      It was the thing making the grid look untidy: four cards in a row had four
      different amounts of text, so the prices sat at four different heights, and
      the copy was clipped mid-word to fit. A card now carries the image, what the
      thing is, its name and its price — which is what a shelf label carries. The
      description is one click away, on the product page, where there is room to
      read it properly.

      Tasting notes for tea are shown as chips instead, on the product page.
    %>

    <%# The spec row ("3 sizes · 16 cm–19 cm", "Strung by hand in 2024") is gone.
        It repeated what the price line already implies and pushed the price off
        the fold of a phone card. %>

    <div class="tea-foot">
      <div class="price">
        <% if (product.priceFrom === product.priceTo) { %>
          <%= money(product.priceFrom) %>
          <small>· <%= dv ? dv.label : '' %></small>
        <% } else { %>
          <small>from</small> <%= money(product.priceFrom) %>
        <% } %>
      </div>
    </div>
  </div>
</article>
