<div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span><span>Basket</span>
  </nav>
</div>

<section class="wrap" style="padding-bottom:clamp(60px,8vw,110px)">
  <span class="eyebrow">Step 1 of 2</span>
  <h1 style="margin:14px 0 34px">Your basket</h1>

  <div class="cart-layout">
    <div>
      <div data-cart-page></div>

      <div class="row" style="gap:12px;margin-top:28px" data-cart-empty-show>
        <a class="btn btn-ghost" href="/shop">← Continue shopping</a>
      </div>
    </div>

    <aside class="summary-card" data-cart-empty-hide>
      <h3 style="font-size:1.2rem;margin-bottom:20px">Order summary</h3>

      <div class="ship-meter" data-ship-meter style="margin-bottom:22px">
        <div class="ship-meter-bar"><div class="ship-meter-fill" data-ship-fill style="width:0"></div></div>
        <p class="tiny muted" style="margin-top:9px" data-ship-text></p>
      </div>

      <div class="totals">
        <div class="totals-row"><span>Subtotal</span><span class="mono" data-cart-subtotal><%= money(0) %></span></div>
        <div class="totals-row"><span>Shipping</span><span class="mono" data-cart-shipping>—</span></div>
        <div class="totals-row"><span><%= store.taxLabel %></span><span class="mono" data-cart-tax>—</span></div>
        <div class="totals-row grand"><span>Total</span><span class="price" data-cart-total><%= money(0) %></span></div>
      </div>

      <a class="btn btn-solid btn-block" href="/checkout" style="margin-top:26px">Proceed to checkout</a>

      <div class="secure-note" style="margin-top:18px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <span>Encrypted checkout · 3-D Secure 2 · OTT Pay</span>
      </div>

      <div class="card-logos" style="margin-top:16px;justify-content:center">
        <img src="/img/badge/visa.svg" alt="Visa" loading="lazy" />
        <img src="/img/badge/mastercard.svg" alt="Mastercard" loading="lazy" />
        <img src="/img/badge/amex.svg" alt="American Express" loading="lazy" />
        <img src="/img/badge/unionpay.svg" alt="China UnionPay" loading="lazy" />
      </div>
    </aside>
  </div>
</section>
