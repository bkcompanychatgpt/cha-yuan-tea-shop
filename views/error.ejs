<div class="wrap wrap-narrow">
  <section style="padding-block:clamp(70px,12vw,160px);text-align:center">
    <p class="gold" style="font-family:var(--font-display);font-size:3.4rem;line-height:1"><%= status %></p>
    <span class="eyebrow" style="display:block;margin-top:22px">Error <%= status %></span>
    <h1 style="margin:16px 0 18px">
      <%= status === 404 ? 'That page has gone cold' : 'Something went wrong' %>
    </h1>
    <p class="lede" style="margin:0 auto 30px"><%= message %></p>

    <div class="row" style="gap:12px;justify-content:center;flex-wrap:wrap">
      <a class="btn btn-solid" href="/shop">Browse the tea</a>
      <a class="btn btn-ghost" href="/">Back to the beginning</a>
    </div>

    <% if (status !== 404) { %>
      <p class="small faint" style="margin-top:30px">
        Nothing has been charged, and no order was placed. If you were paying, check
        <a class="link-underline" href="/order">your order</a> before trying again.
      </p>
    <% } %>
  </section>
</div>
