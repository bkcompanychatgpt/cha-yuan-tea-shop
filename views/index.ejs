<% const ed = (typeof editorial !== 'undefined' && editorial) ? editorial : { pillars: [], guides: [], ticker: [], trust: [] }; %>

<!-- ===================================================== announcement ticker -->
<% if (ed.ticker && ed.ticker.length) { %>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <% [0, 1].forEach(() => { %>
        <% ed.ticker.forEach(item => { %>
          <span class="ticker-item"><%= item %></span>
        <% }) %>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- ================================================================== hero -->
<%
  // The homepage is a directory: the departments, then a few entry points into
  // each. Products live inside their collection, which is where someone who
  // wants to choose a piece will go.
  const KIND_LABELS = {
    tea: { label: 'Tea', blurb: 'Single-origin lots from Fujian, Yunnan, Anhui and Guangdong' },
    jade: { label: 'Jade & Stone', blurb: 'Nephrite and jadeite, hand-carved' },
    jewellery: { label: 'Fine Jewellery', blurb: 'Gold, pearls, and jade set in gold' },
    teaware: { label: 'Teaware', blurb: 'Gaiwan, clay pots and the vessels that brew it best' },
    gift: { label: 'Gift Sets', blurb: 'Boxed flights, ready to give' },
  };

  const buildDept = (kind) => {
    const members = categories.filter((c) => c.kind === kind);
    if (!members.length) return null;
    const hero = members.reduce((a, b) => (b.product_count > a.product_count ? b : a));
    return {
      kind,
      label: KIND_LABELS[kind].label,
      // Spread onto the same shape the department cards use, so the "Beyond the
      // three" row and the departments row can be rendered by the same markup.
      // Without this the teaware and gift cards rendered `<img src="">` — two
      // broken images that the visual check caught and the eye would not.
      coverSrc: hero.hero_image,
      blurb: KIND_LABELS[kind].blurb,
      count: members.reduce((n, c) => n + c.product_count, 0),
      hero,
      members,
    };
  };

  const departments = ['tea', 'jade', 'jewellery'].map(buildDept).filter(Boolean);
  const outros = ['teaware', 'gift'].map(buildDept).filter(Boolean);
  const totalProducts = categories.reduce((n, c) => n + c.product_count, 0);
%>

<%
  /*
   * The hero photograph.
   *
   * Chosen by looking at all eight candidates side by side (sheet-heroes.mjs).
   * Most of the editorial set has a picker's face in it, which is wrong for a
   * commercial banner and wrong twice over when the face belongs to a child, and
   * the previous pick was a close crop of somebody's back and basket that read as
   * a brown smear at banner size. Withering beds are the one frame that is
   * unmistakably tea production, has nobody in it, and leaves the left third
   * plain enough for the headline to sit on.
   */
  const heroShot = '/img/photos/home-hero-hero-wide.jpg';
%>

<section class="hero hero-banner">
  <div class="hero-bg">
    <img src="<%= heroShot %>" alt="" />
  </div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">Single-origin &middot; small lots</span>
      <h1>Chinese tea, jade and&nbsp;jewellery</h1>
      <p class="hero-sub">
        <%= totalProducts %> pieces across <%= categories.length %> collections, bought in small
        lots and tasted before they are listed. Free shipping over
        <%= money(store.freeShippingThreshold) %>.
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="/shop">Browse everything</a>
        <a class="btn btn-ghost" href="/guides">How to brew it</a>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================== departments -->
<section class="section-tight" id="departments">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">The shop</span>
        <h2>Departments</h2>
      </div>
      <div class="section-head-rule"></div>
      <a class="link-underline small nowrap" href="/shop">All <%= totalProducts %> pieces &rarr;</a>
    </div>

    <div class="dept-grid">
      <%
        /*
         * The three departments, from the same source the shop chooser uses, so
         * the homepage and /shop cannot describe them differently.
         *
         * The category list that used to be printed inside each card is gone.
         * Tea has eight kinds and the other two have one, so the cards were wildly
         * uneven — two of them were two-thirds empty space, which is what made
         * this row look wrong. The kinds belong one level down, after you have
         * chosen Tea, which is also what the shop page now does.
         */
        const deptCards = (typeof cards !== 'undefined' && cards && cards.departments)
          ? cards.departments
          : [];
      %>
      <% deptCards.forEach((dept) => { %>
        <a class="dept" href="<%= dept.href %>">
          <div class="dept-media"><img src="<%= dept.coverSrc %>" alt="" loading="lazy" /></div>
          <div class="dept-body">
            <span class="eyebrow"><%= dept.eyebrow %></span>
            <h3><%= dept.name %></h3>
            <p class="dept-count"><%= dept.count %> pieces</p>
            <p class="dept-blurb"><%= dept.blurb %></p>
            <span class="dept-cta">Enter &rarr;</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============================================ the rest of the catalogue -->
<% if (outros.length) { %>
  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Also</span>
          <h2>Beyond the three</h2>
        </div>
        <div class="section-head-rule"></div>
      </div>

      <div class="dept-grid dept-grid-outros">
        <% outros.forEach((dept) => { %>
          <a class="dept dept-small" href="/shop?category=<%= encodeURIComponent(dept.hero.slug) %>">
            <div class="dept-media"><img src="<%= dept.coverSrc %>" alt="" loading="lazy" /></div>
            <div class="dept-body">
              <span class="eyebrow"><%= dept.count %> pieces</span>
              <h3><%= dept.label %></h3>
              <p><%= dept.blurb %></p>
              <span class="dept-cta">Enter &rarr;</span>
            </div>
          </a>
        <% }) %>
      </div>

      <%
        /*
         * The twelve-collection chip row used to sit here, and it was the single
         * messiest thing on the page: a flat list of every category presented as
         * though they were all peers, directly under the three departments that
         * already organise them. The departments show their own collections, so
         * this repeated every one of them a second time.
         */
      %>
      <p class="dept-footer">
        <span class="tiny faint" style="letter-spacing:0.16em;text-transform:uppercase">Twelve collections</span>
        <a class="link-underline small" href="/shop">See the whole catalogue &rarr;</a>
      </p>
    </div>
  </section>
<% } %>

<!-- ================================================================ brewing -->
<% if (ed.brewing) { %>
  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow"><%= ed.brewing.eyebrow %></span>
          <h2><%= ed.brewing.heading %></h2>
        </div>
        <div class="section-head-rule"></div>
        <p><%= ed.brewing.intro %></p>
      </div>

      <div class="brew-steps">
        <% ed.brewing.steps.forEach((step, i) => { %>
          <div class="brew-step">
            <span class="step-no"><%= String(i + 1).padStart(2, '0') %></span>
            <h4><%= step.title %></h4>
            <p><%= step.body %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<!-- ============================================================ trust strip -->
<% if (ed.trust && ed.trust.length) { %>
  <section class="trust-strip">
    <div class="wrap">
      <div class="trust-grid">
        <% ed.trust.forEach(t => { %>
          <div class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <% if (t.icon === 'leaf') { %><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/>
              <% } else if (t.icon === 'calendar') { %><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/>
              <% } else if (t.icon === 'gaiwan') { %><path d="M4 10h16"/><path d="M6 10c0 5 2.7 8 6 8s6-3 6-8"/><path d="M9 6h6"/><path d="M12 3v3"/>
              <% } else { %><path d="M12 2 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6Z"/><path d="m9 12 2 2 4-4"/>
              <% } %>
            </svg>
            <div>
              <h4><%= t.title %></h4>
              <p><%= t.body %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<!-- ================================================================= story -->
<section class="section-tight" style="background:linear-gradient(180deg,var(--ink-900),var(--ink-850),var(--ink-900));border-block:1px solid var(--line-soft)">
  <div class="wrap">
    <%
      const story = (ed.photos && ed.photos.story) ? ed.photos.story : [];
      const storyPicks = story.length ? story : [{ src: '/img/editorial/wuyi-shuixian-detail.svg', key: 'default' }];
      const storyHero = storyPicks[0];
    %>
    <div class="story-layout">
      <div class="story-media">
        <figure class="story-media-main">
          <img src="<%= storyHero.src %>" alt="Tea terraces" loading="lazy" />
        </figure>
        <div class="story-media-side">
          <% storyPicks.slice(1, 4).forEach((shot) => { %>
            <figure><img src="<%= shot.src %>" alt="" loading="lazy" /></figure>
          <% }) %>
        </div>
      </div>

      <div>
        <span class="eyebrow">How we buy</span>
        <h2 style="margin:14px 0 18px">A shop built on a tasting table, not a warehouse</h2>
        <p class="lede" style="margin-bottom:26px"><%= ed.intro %></p>
        <div class="pillars" style="grid-template-columns:1fr 1fr;gap:22px">
          <% (ed.pillars || []).forEach((p, i) => { %>
            <div class="pillar">
              <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
              <h4><%= p.title %></h4>
              <p><%= p.body %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================== from the source -->
<% if (ed.photos && ed.photos.story && ed.photos.story.length > 4) { %>
  <section class="section-tight">
    <div class="wrap">
      <div class="photo-row">
        <% ed.photos.story.slice(4, 8).forEach((shot, i) => { %>
          <figure class="photo-row-item">
            <img src="<%= shot.wide || shot.src %>" alt="" loading="lazy" />
            <figcaption>
              <%= ['Spring plucking', 'Withering beds', 'The tasting room', 'Glazed and gilded'][i] || 'From the source' %>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<!-- ================================================================= guides -->
<section class="section-tight">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">Knowledge</span>
        <h2>Learn to brew it properly</h2>
      </div>
      <div class="section-head-rule"></div>
      <a class="link-underline small nowrap" href="/guides">All guides &rarr;</a>
    </div>

    <div class="guide-list">
      <% (ed.guides || []).slice(0, 3).forEach(g => { %>
        <a class="guide-card" href="/guides/<%= g.slug %>">
          <span class="eyebrow"><%= g.family %></span>
          <h3><%= g.title %></h3>
          <p><%= g.summary %></p>
          <span class="link-underline small" style="margin-top:auto">Read the guide &rarr;</span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================================================================== FAQ -->
<% if (ed.faq && ed.faq.length) { %>
  <section class="section-tight">
    <div class="wrap">
      <div class="faq-layout">
        <div>
          <span class="eyebrow">Questions</span>
          <h2 style="margin:14px 0 18px">Answered before you ask</h2>
          <p class="lede" style="font-size:0.95rem">
            Anything not covered here, write to us &mdash; every message is answered by the person who chose the piece.
          </p>
          <a class="btn btn-ghost" href="/about" style="margin-top:22px">More about us</a>
        </div>

        <div class="faq-list">
          <% ed.faq.forEach(f => { %>
            <div class="faq-item">
              <button class="faq-q" type="button" aria-expanded="false">
                <span><%= f.q %></span>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="16" height="16"><path d="m9 6 6 6-6 6"/></svg>
              </button>
              <div class="faq-a"><p><%= f.a %></p></div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>
<% } %>

<!-- ============================================================ newsletter -->
<section class="section-tight newsletter">
  <div class="wrap wrap-mid">
    <span class="eyebrow">The tea letter</span>
    <h2 style="margin:14px 0 12px">New lots, before they sell out</h2>
    <p class="muted" style="max-width:52ch;margin:0 auto">
      One letter a season: what has just landed, what is nearly gone, and a note on how to brew it.
    </p>
    <form data-newsletter>
      <input type="email" name="email" placeholder="you@example.com" aria-label="Email address" required />
      <button class="btn btn-solid" type="submit">Subscribe</button>
    </form>
    <p class="tiny faint" style="margin-top:14px" data-newsletter-status></p>
  </div>
</section>
