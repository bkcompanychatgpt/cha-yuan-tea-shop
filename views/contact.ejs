<div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span><span>Contact us</span>
  </nav>
</div>

<section class="wrap wrap-mid" style="padding-bottom:clamp(60px,8vw,110px)">
  <span class="eyebrow">Policy</span>
  <h1 style="margin:14px 0 18px">Contact us</h1>
  <p class="lede">A real person reads every message. If you are asking about an order, quote the order number and
    you will get a faster, better answer.</p>

  <div class="stack-32" style="margin-top:44px">
    <%
      /*
       * WhatsApp, once a number exists.
       *
       * It sits above the email desks rather than beside them because it is the
       * faster channel and the one a customer with an order in progress will
       * reach for. It is simply absent until the number is supplied — a chat
       * button that nobody answers is worse than no button, so this is not a
       * placeholder that gets published by accident.
       */
      const whatsapp = (config && config.whatsapp) ? config.whatsapp : null;
    %>
    <% if (whatsapp) { %>
      <div class="panel">
        <h3 style="margin-bottom:10px">Chat on WhatsApp</h3>
        <p style="color:var(--text-dim);line-height:1.85;font-size:0.94rem;margin-bottom:18px">
          The quickest way to reach a person, particularly about an order already placed. Quote your order number and
          we can look it up straight away. Nothing about payment is ever handled over WhatsApp: we will never ask for
          card details there, and the only place card details are entered is the checkout on this site.
        </p>
        <a class="btn btn-solid" href="<%= whatsapp.url %>" target="_blank" rel="noopener noreferrer">
          Message us on WhatsApp<span class="mono" style="margin-left:10px"><%= whatsapp.display %></span>
        </a>
        <p class="tiny faint" style="margin-top:14px">
          Opens in the WhatsApp app or in WhatsApp Web, whichever you have.
        </p>
      </div>
    <% } %>

    <div class="contact-grid">
      <% const desks = [
        {
          label: 'Orders, shipping and returns',
          email: company.email,
          note: 'Order changes, delivery questions, returns and refunds. Quote your order number.',
        },
        {
          label: 'Before you buy',
          email: company.email,
          note: 'Which lot suits you, how to brew it, which bead size is right for a wrist, and how a stone looks in daylight rather than in a photograph.',
        },
        {
          label: 'Privacy and your data',
          email: company.privacyEmail,
          note: 'Access, correction or deletion requests, and anything about how we handle your data.',
        },
      ]; %>
      <% desks.forEach(desk => { %>
        <div class="panel">
          <h3 style="margin-bottom:10px"><%= desk.label %></h3>
          <p style="color:var(--text-dim);line-height:1.85;font-size:0.92rem;margin-bottom:14px"><%= desk.note %></p>
          <a class="link-underline mono" href="mailto:<%= desk.email %>"><%= desk.email %></a>
        </div>
      <% }) %>
    </div>

    <div class="panel">
      <h3 style="margin-bottom:16px">The details behind the shop</h3>
      <div class="contact-table">
        <div><span>Registered name</span><span><%= company.legalName %></span></div>
        <div><span>Trading as</span><span><%= company.tradingName %></span></div>
        <div>
          <span>Registered address</span>
          <span><% company.addressLines.forEach((line, i) => { %><%= line %><% if (i < company.addressLines.length - 1) { %><br /><% } %><% }) %></span>
        </div>
        <div><span>Country of establishment</span><span><%= company.country %></span></div>
        <div>
          <span>Company registration</span>
          <span class="mono"><%= company.missing.registrationNumber ? 'To be supplied' : company.registrationNumber %></span>
        </div>
        <div>
          <span>Tax registration</span>
          <span class="mono"><%= company.missing.taxNumber ? 'To be supplied' : company.taxNumber %></span>
        </div>
        <div><span>Contact person</span><span><%= company.contactPerson %></span></div>
        <div><span>Telephone</span><span><a class="link-underline" href="tel:<%= company.phone.replace(/[^+0-9]/g, '') %>"><%= company.phone %></a></span></div>
        <div><span>Opening hours</span><span><%= company.hours %></span></div>
        <div><span>Reply time</span><span>Within <%= company.responseTime %></span></div>
        <div><span>Language</span><span>English</span></div>
        <%#
          The returns address, shown rather than withheld.

          This row used to say "email us and we will send the address", which was
          true while returns went to a warehouse whose address was not published.
          Returns now come to the registered office, so the policy page and this
          page say the same thing — a customer deciding whether a return is worth
          the postage needs the address before writing to us, not after.
        %>
        <div>
          <span>Returns address</span>
          <span>
            <% if (company.hasReturnsAddress) { %>
              <%= company.returnsAddressLines.join(', ') %> —
              email us first for a return authorisation and put its number on the parcel
            <% } else { %>
              Email us first for a return authorisation, and we will send the address to use
            <% } %>
          </span>
        </div>
      </div>

      <% if (company.isPlaceholder) { %>
        <%
          /*
           * Only the rows that are actually missing are called out.
           *
           * The company name, address, telephone and email are real, so a blanket
           * "these are samples" warning would now be wrong in a way that makes the
           * whole block look untrustworthy. What is genuinely outstanding is the
           * Ontario corporate number and the HST number, and they are marked in
           * the table above rather than invented.
           */
          const missingRows = [];
          if (company.missing.registrationNumber) missingRows.push({
            env: 'COMPANY_REGISTRATION_NUMBER',
            what: 'the Ontario corporate registration number',
          });
          if (company.missing.taxNumber) missingRows.push({
            env: 'COMPANY_TAX_NUMBER',
            what: 'the HST registration number',
          });
        %>
        <div class="alert alert-warn" style="margin-top:22px">
          <strong>Two numbers still to be supplied:</strong>
          <%= missingRows.map((r) => r.what).join(' and ') %>. They are left blank rather than filled with
          something that looks right, because a registration number is the one line on this page a customer or a
          card scheme might actually look up. Set
          <% missingRows.forEach((r, i) => { %><span class="mono"><%= r.env %></span><% if (i < missingRows.length - 1) { %> and <% } %><% }) %>
          on the host and this notice disappears.
        </div>
      <% } %>
    </div>

    <div class="panel">
      <h3 style="margin-bottom:16px">How we answer</h3>
      <div class="stack-12" style="color:var(--text-dim);line-height:1.85;font-size:0.94rem">
        <p>Messages are read in the order they arrive, <%= company.hours %>, and answered within
          <%= company.responseTime %>. A message sent on a Friday evening is answered on Monday, not over the
          weekend.</p>
        <p>If your question is about an order in progress, quoting the order number — it is in the confirmation email
          and on the <a class="link-underline" href="/order">track an order</a> page — means we do not have to write
          back and ask for it, which is the single biggest cause of a slow reply.</p>
        <p>We do not take card details over email, the telephone or any messaging app, and we will never ask for them.
          Payment is taken only in the checkout on this site.</p>
      </div>
    </div>

    <div class="panel">
      <h3 style="margin-bottom:16px">Something wrong with the site?</h3>
      <div class="stack-12" style="color:var(--text-dim);line-height:1.85;font-size:0.94rem">
        <p>If a page will not load, a payment fails without explanation, or the checkout does something odd, tell us
          what you were doing and what you saw. Those reports are the only way we find out — and if a payment failed,
          say so explicitly and we will check whether your card was charged, because an authorisation that never
          completed can still show as pending at your bank for a few days.</p>
      </div>
    </div>
  </div>

  <div class="row" style="gap:12px;margin-top:40px;flex-wrap:wrap">
    <a class="btn btn-ghost" href="/shipping">Shipping policy</a>
    <a class="btn btn-ghost" href="/refund">Refund policy</a>
    <a class="btn btn-ghost" href="/privacy">Privacy policy</a>
    <a class="btn btn-solid" href="/shop">Shop the tea</a>
  </div>
</section>
