<div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span>
    <% if (activeCategory) { %>
      <a href="/shop">Shop</a><span class="sep">/</span>
      <span><%= activeCategory.name %></span>
    <% } else { %>
      <span>All products</span>
    <% } %>
  </nav>
</div>

<section class="wrap" style="padding-bottom:34px">
  <span class="eyebrow"><%= activeCategory ? activeCategory.tagline : 'The full catalogue' %></span>
  <h1 style="margin:14px 0 18px"><%= activeCategory ? activeCategory.name : 'All tea and teaware' %></h1>
  <p class="lede">
    <%= activeCategory
      ? activeCategory.description
      : 'Single-origin Chinese tea bought in small lots, plus the vessels that brew it best. Every lot is dated by harvest and brewed before it is listed.' %>
  </p>

  <div style="margin-top:34px">
    <form method="get" action="/shop">
      <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>" /><% } %>
      <% if (filters.stock) { %><input type="hidden" name="stock" value="<%= filters.stock %>" /><% } %>

      <div class="toolbar">
        <span class="tiny faint" style="letter-spacing:0.16em;text-transform:uppercase">Filter</span>

        <a class="chip <%= !filters.category && !filters.family ? 'is-active' : '' %>" href="/shop<%= filters.q ? `?q=${encodeURIComponent(filters.q)}` : '' %>">All</a>
        <% categories.filter(c => c.kind === 'tea').forEach(c => { %>
          <a class="chip <%= filters.category === c.slug ? 'is-active' : '' %>" href="/shop?category=<%= encodeURIComponent(c.slug) %><%= filters.sort && filters.sort !== 'featured' ? `&sort=${filters.sort}` : '' %>"><%= c.name %></a>
        <% }) %>
        <% categories.filter(c => c.kind !== 'tea').forEach(c => { %>
          <a class="chip <%= filters.category === c.slug ? 'is-active' : '' %>" href="/shop?category=<%= encodeURIComponent(c.slug) %>"><%= c.name %></a>
        <% }) %>

        <div class="right row" style="gap:12px">
          <a class="chip <%= filters.stock === '1' ? 'is-active' : '' %>" href="/shop?<%= new URLSearchParams({ ...filters, stock: filters.stock === '1' ? '' : '1' }).toString() %>">In stock only</a>
          <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>" /><% } %>
          <% if (filters.family) { %><input type="hidden" name="family" value="<%= filters.family %>" /><% } %>
        </div>
      </div>
    </form>
  </div>
</section>

<section class="wrap" style="padding-bottom:clamp(60px,8vw,110px)">
  <div class="result-bar">
    <div>
      <div class="rb-count">
        <%= total %> <%= total === 1 ? 'product' : 'products' %>
        <small><% if (filters.q) { %>matching “<%= filters.q %>”<% } else if (activeCategory) { %>in <%= activeCategory.name %><% } else { %>in the whole shop<% } %></small>
      </div>
    </div>
    <div class="rb-actions">
      <span class="tiny faint">Showing <%= products.length ? (page - 1) * perPage + 1 : 0 %>–<%= (page - 1) * perPage + products.length %></span>
      <% if (filters.q || filters.category || filters.family || filters.stock) { %>
        <a class="chip" href="/shop">✕ Clear filters</a>
      <% } %>
      <div class="row" style="gap:8px">
        <span class="tiny faint">Sort</span>
        <form method="get" action="/shop" style="display:inline">
          <% ['q','category','family','stock'].forEach(k => { if (filters[k]) { %><input type="hidden" name="<%= k %>" value="<%= filters[k] %>" /><% } }) %>
          <select class="select" name="sort" data-auto-submit style="width:auto;padding:8px 12px;font-size:0.78rem">
            <% [['featured','Featured'],['newest','Newest'],['price-asc','Price ↑'],['price-desc','Price ↓'],['rating','Highest rated'],['name','A – Z']].forEach(([v, label]) => { %>
              <option value="<%= v %>" <%= filters.sort === v ? 'selected' : '' %>><%= label %></option>
            <% }) %>
          </select>
        </form>
      </div>
    </div>
  </div>

  <% if (!products.length) { %>
    <div class="panel" style="text-align:center;padding:70px 30px">
      <p class="gold" style="font-family:var(--font-display);font-size:3rem;line-height:1">Nothing found</p>
      <h3 style="margin:20px 0 10px">No tea matches that</h3>
      <p class="muted">Try a broader search, or browse the whole catalogue.</p>
      <a class="btn" href="/shop" style="margin-top:24px">Browse all products</a>
    </div>
  <% } else { %>
    <div class="tea-grid">
      <% products.forEach(product => { %>
        <%- include('partials/tea-card', { product, money }) %>
      <% }) %>
    </div>
  <% } %>

  <% if (pages > 1) { %>
    <nav class="pagination" aria-label="Pagination">
      <% if (page > 1) { %>
        <a href="?<%= new URLSearchParams({ ...filters, page: String(page - 1) }).toString() %>" aria-label="Previous page">←</a>
      <% } %>
      <% for (let p = 1; p <= pages; p += 1) { %>
        <% if (p === page) { %>
          <span class="is-current" aria-current="page"><%= p %></span>
        <% } else { %>
          <a href="?<%= new URLSearchParams({ ...filters, page: String(p) }).toString() %>"><%= p %></a>
        <% } %>
      <% } %>
      <% if (page < pages) { %>
        <a href="?<%= new URLSearchParams({ ...filters, page: String(page + 1) }).toString() %>" aria-label="Next page">→</a>
      <% } %>
    </nav>
  <% } %>

  <div class="band" style="margin-top:44px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/></svg>
    <p>
      <strong>Free shipping over <%= money(store.freeShippingThreshold) %></strong> ·
      flat <%= money(store.flatShippingFee) %> below that · parcels leave our tea room in Canada within one business day ·
      <a class="link-underline" href="/shipping">shipping &amp; returns</a>
    </p>
  </div>
</section>
