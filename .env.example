# ============================================================================
#  CHA YUAN  (茶叶)  —  Environment configuration
#  Copy this file to  .env  and fill in your real values.
# ============================================================================

# ---------------------------------------------------------------------------
#  1. STORE
# ---------------------------------------------------------------------------
STORE_NAME="Cha Yuan"
STORE_TAGLINE="Single-origin Chinese tea, sourced at the mountain."
# Public base URL of THIS site. Must be reachable by the internet so that
# OTT Pay can POST the payment callback to it, and so that the cardholder is
# redirected back after the 3-D Secure challenge.
# For local testing you can use a tunnel (ngrok / cloudflared), e.g.
#   PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:3080

# Base currency. OTT Pay local card settles in CAD for Canadian merchants.
# All internal amounts are stored in CENTS (integer) and sent to OTT Pay
# as an integer number of cents ("100" == one dollar).
CURRENCY=CAD
CURRENCY_SYMBOL=$

# Free shipping threshold, in dollars. Above this, shipping is free.
FREE_SHIPPING_THRESHOLD=79
# Flat shipping fee in dollars, applied below the threshold.
FLAT_SHIPPING_FEE=9.5
# Sales tax rate applied to (subtotal + shipping). 0.13 == 13% HST (Ontario).
TAX_RATE=0.13
# Label shown to the customer for this tax line.
TAX_LABEL=HST (13%)

# ---------------------------------------------------------------------------
#  2. OTT PAY  —  LOCAL CARD 3-D SECURE PAYMENT
# ---------------------------------------------------------------------------
# PAYMENT_MODE:
#   mock     -> no network calls are made. A realistic simulated acquirer
#               drives the whole flow (authorise / 3DS challenge / decline /
#               refund / callback) so the shop is fully demonstrable.
#   sandbox  -> https://sandbox-api.ottpay.com/  + your sandbox appId/appKey.
#               Use ONLY the OTT Pay test cards.
#   live     -> https://ecom-api.ottpay.com/  + your production credentials.
#               REAL MONEY. Do not enable until OTT Pay has certified you.
PAYMENT_MODE=mock

# Credentials issued by OTT Pay (Sandbox merchant account email).
# appId / appKey are used to obtain the short-lived JWT bearer token.
OTT_APP_ID=
OTT_APP_KEY=
# signKey is used to decrypt the AES-ECB payload of the payment callback.
OTT_SIGN_KEY=
# Your OTT Pay merchant id, e.g. CAMB006711 / ON00004652.
OTT_MERCHANT_ID=

# API hosts. Leave as-is unless OTT Pay tells you otherwise.
OTT_SANDBOX_BASE_URL=https://sandbox-api.ottpay.com
OTT_LIVE_BASE_URL=https://ecom-api.ottpay.com

# The bearer token lives 15 minutes; we refresh it 60s early.
OTT_TOKEN_TTL_SECONDS=900
OTT_TOKEN_REFRESH_SKEW_SECONDS=60
# HTTP timeout for outbound OTT Pay calls, milliseconds.
OTT_HTTP_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
#  3. KOUNT  —  DEVICE DATA COLLECTION (3DS2 fraud mitigation)
#  OTT Pay activates KOUNT on all accounts. The browser SDK collects a device
#  fingerprint and returns a session ID which is sent to OTT Pay as
#  `sessionId` (top level) and `purchase3DSAddition.sessionID`.
#  Leave KOUNT_CLIENT_ID empty to skip device data collection (the gateway
#  will fall back to the plain browser fields we always send).
# ---------------------------------------------------------------------------
KOUNT_CLIENT_ID=
# TEST while developing, PROD in production (per OTT Pay docs).
KOUNT_ENVIRONMENT=TEST

# ---------------------------------------------------------------------------
#  4. SERVER / SECURITY
# ---------------------------------------------------------------------------
PORT=3080
HOST=127.0.0.1
NODE_ENV=development

# Random long string — signs the admin session cookie and CSRF tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Admin back-office login (change before going live).
ADMIN_EMAIL=owner@chayuan.test
ADMIN_PASSWORD=changeme-please

# SQLite database file.
DATABASE_FILE=./data/shop.db

# Trust X-Forwarded-For (set to 1 when behind nginx / Cloudflare / a tunnel).
TRUST_PROXY=0
